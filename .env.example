# ==========================================
# CardWise Server Environment Configuration
# ==========================================

# Server Port
PORT=3001
NODE_ENV=development

# Database Configuration
# Leave DATABASE_URL empty or unset to automatically use embedded PostgreSQL (PGlite)
# Or provide a full connection string to connect to a PostgreSQL instance:
# DATABASE_URL=postgresql://cardwise_user:cardwise_password@localhost:5432/cardwise_db

# Client Dashboard URL (CORS allowed origin)
DASHBOARD_URL=http://localhost:5173

# Demo Profile Configuration
DEFAULT_PROFILE_ID=demo-user-1
DEMO_MODE=true

# Chrome Extension Service Worker Endpoint
EXTENSION_API_BASE=http://localhost:3001/api
